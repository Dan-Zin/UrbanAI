# --- Urban AI API keys ---
# Leave any of these empty to run that service in Mock Mode (demo works with zero keys).

# Mapbox GL JS access token (https://account.mapbox.com/access-tokens/)
# OPTIONAL: without it the app uses free Leaflet + CARTO dark raster tiles (no key needed).
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenRouter — NLP sentiment analysis (https://openrouter.ai/keys)
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Fal.ai — generative design renders (https://fal.ai/dashboard/keys)
NEXT_PUBLIC_FAL_API_KEY=

# Tripo AI — text-to-3D asset generation (placeholder integration)
NEXT_PUBLIC_TRIPO_API_KEY=

# Mapillary — street-level photos for AI reconstruction (https://mapillary.com/developer)
# OPTIONAL: Wikimedia Commons geosearch is used automatically as a no-key photo source.
NEXT_PUBLIC_MAPILLARY_TOKEN=
